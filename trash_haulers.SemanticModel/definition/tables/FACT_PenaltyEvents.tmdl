	column Alt1Policy
		dataType: int64
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6197e1bb-701c-4959-91bf-17ab2a2ca103
		summarizeBy: sum
		sourceColumn: Alt1Policy

		changedProperty = DataType

