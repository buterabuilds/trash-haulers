	column AddressKey
		dataType: string
		lineageTag: d10b8b1f-8f26-4654-8b8a-697344263ce8
		summarizeBy: none
		sourceColumn: AddressKey

		annotation SummarizationSetBy = Automatic

	column TrashHaulerKey
		dataType: string
		lineageTag: 374eb717-3ea7-4805-ae3f-be84d669ae82
		summarizeBy: none
		sourceColumn: TrashHaulerKey

