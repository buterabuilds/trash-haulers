	column CurrentPolicy
		dataType: int64
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b80ce77e-48fa-4fe3-917a-0f7040e92470
		summarizeBy: sum
		sourceColumn: CurrentPolicy

