table FACT_PenaltyEvents
	lineageTag: 24a3d851-9cc6-4a75-b902-e51b0a5ab7c4

	column 'Date Opened'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 4624bbe8-8db8-4d80-a055-c52e81e7f555
		summarizeBy: none
		sourceColumn: Date Opened

		changedProperty = DataType

