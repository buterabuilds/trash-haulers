	column Year-Week
		lineageTag: 1514ec30-d21d-4b6a-a7c7-ba5222f9be57
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year-Week]

		annotation SummarizationSetBy = Automatic

	column 'Week Starting'
		formatString: Short Date
		lineageTag: 1505bafd-f252-4dcc-8f3d-f601b7adc565
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Starting]

		annotation SummarizationSetBy = Automatic

	column YearCategory =
			
			VAR MaxYear = MAXX('DIM_Date', 'DIM_Date'[Year])
			RETURN
			SWITCH(
			    TRUE(),
			    'DIM_Date'[Year] = MaxYear, "Current Year",
			    'DIM_Date'[Year] = MaxYear - 1, "Last Year",
			    "Older Years"
			)
		lineageTag: 49daa722-f669-4123-88bb-2bca1adb65ff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy 'Date Hierarchy'
		lineageTag: d9719348-8a4d-4a2f-8d27-bdc18b851368

		level Year
			lineageTag: 9ae06659-101e-4afc-8e11-4c83feafa52f
			column: Year

		level 'Month No'
			lineageTag: 78ce8058-ee66-4ada-bed6-6c56ba86e05a
			column: 'Month No'

		level Quarter
			lineageTag: 55552909-e8a6-41b8-953d-2e61202714ba
			column: Quarter

		level Weekday
			lineageTag: 9c5f0ca9-40c8-49ca-8fab-c387cbc154b7
			column: Weekday

	partition DIM_Date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDARAUTO(),
				    "Year", YEAR([Date]),
				    "Month No", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Weekday", FORMAT([Date], "ddd"),
				
				    "Week No", WEEKNUM([Date], 2),
				    "ISO Week No", WEEKNUM([Date], 12),
				    "Year-Week", FORMAT([Date], "YYYY") & "-W" & FORMAT(WEEKNUM([Date], 21), "00"),
				    "Week Starting", [Date] - WEEKDAY([Date], 2) + 1
				)

	annotation PBI_Id = 9d9b4e64a846428abad73a10a8a5a1a4

