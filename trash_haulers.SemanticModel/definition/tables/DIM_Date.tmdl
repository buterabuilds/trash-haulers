table DIM_Date
	lineageTag: 907c2c55-db2d-4ad0-be07-32966da5c7c1
	dataCategory: Time

	column Date
		isKey
		formatString: Short Date
		lineageTag: 94571601-eb2e-48fe-9dce-f02b35595137
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

